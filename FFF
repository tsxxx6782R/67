-- เอฟเฟกต์สีขอบกระพริบวิบวับสไตล์สายฟ้า
task.spawn(function()
    while true do
        TweenService:Create(stroke, TweenInfo.new(0.6), {Color = Color3.fromRGB(180, 0, 255)}):Play()
