-- ฟังก์ชันสร้างปุ่มตัวเลือกด้านใน
local function createButton(name, positionY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 220, 0, 45)
    btn.Position = UDim2.new(0, 20, 0, positionY)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.Parent = mainFrame
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn
    return btn
end

local btnKorblox = createButton("Korblox Leg: OFF", 65)
local btnCleanHud = createButton("Hide HUD (HP/Speed/Time): OFF", 120)
local btnVoice = createButton("🔊 เสียง: อับดุล พร้อมใช้งาน", 175)

-- ฟังก์ชันเล่นเสียง "อับดุล พร้อมใช้งานแล้ว" (ใช้ Sound ID ทางการของ Roblox หรือเสียงแจ้งเตือนระบบ)
local function playAbdulSound()
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9114220037" -- เสียงเอฟเฟกต์แจ้งเตือนระบบสำเร็จ
        sound.Volume = 2
        sound.Parent = SoundService
        sound:Play()
        print("🔊 อับดุล พร้อมใช้งานแล้ว!")
    end)
end

btnVoice.MouseButton1Click:Connect(function()
    playAbdulSound()
    btnVoice.Text = "✅ เสียงเล่นแล้ว!"
    task.wait(1.5)
    btnVoice.Text = "🔊 เสียง: อับดุล พร้อมใช้งาน"
end)

-- ระบบพับหน้าต่าง (Minimize Logic)
local isMinimized = false
minimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    local targetSize = isMinimized and UDim2.new(0, 260, 0, 45) or UDim2.new(0, 260, 0, 320)
    TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = targetSize}):Play()
    minimizeBtn.Text = isMinimized and "+" : "-"
end)

-- สถานะการทำงาน
local isKorbloxOn = false
local isHudHidden = false

-- 3. ฟังก์ชันเปิด/ปิดขากุด (Korblox)
btnKorblox.MouseButton1Click:Connect(function()
    isKorbloxOn = not isKorbloxOn
    btnKorblox.Text = isKorbloxOn and "Korblox Leg: ON" or "Korblox Leg: OFF"
    btnKorblox.BackgroundColor3 = isKorbloxOn and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(35, 35, 45)
    
    local char = player.Character
    if char then
        local r6 = char:FindFirstChild("Right Leg")
        local r15_1 = char:FindFirstChild("RightLowerLeg")
        local r15_2 = char:FindFirstChild("RightFoot")
        local r15_upper = char:FindFirstChild("RightUpperLeg")
        
        if isKorbloxOn then
            if r6 then r6.Transparency = 1; r6.CanCollide = false end
            if r15_1 then r15_1.Transparency = 1; r15_1.CanCollide = false end
            if r15_2 then r15_2.Transparency = 1; r15_2.CanCollide = false end
            if r15_upper then r15_upper.Transparency = 0; r15_upper.BrickColor = BrickColor.new("Really black") end
        else
            if r6 then r6.Transparency = 0; r6.CanCollide = true end
            if r15_1 then r15_1.Transparency = 0; r15_1.CanCollide = true end
            if r15_2 then r15_2.Transparency = 0; r15_2.CanCollide = true end
            if r15_upper then r15_upper.BrickColor = BrickColor.new("Medium stone grey") end
        end
    end
end)

-- 4. ฟังก์ชันซ่อนเฉพาะหลอดเลือด ความเร็ว และตัวเวลา (Evade Specific UI Filter)
btnCleanHud.MouseButton1Click:Connect(function()
    isHudHidden = not isHudHidden
    btnCleanHud.Text = isHudHidden and "Hide HUD: ON" or "Hide HUD (HP/Speed/Time): OFF"
    btnCleanHud.BackgroundColor3 = isHudHidden and Color3.fromRGB(180, 0, 0) or Color3.fromRGB(35, 35, 45)
    
    -- ค้นหาและปิดการมองเห็นเฉพาะ UI ที่เกี่ยวกับหลอดเลือด ความเร็ว หรือเวลาในแมตช์ Evade
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("Frame") or gui:IsA("ImageLabel") then
            local nameLower = gui.Name:lower()
            -- เช็คคำคีย์เวิร์ดที่มักใช้เก็บ UI เลือด, ความเร็ว, หรือเวลา
            if nameLower:find("health") or nameLower:find("hp") or nameLower:find("speed") or nameLower:find("time") or nameLower:find("timer") or nameLower:find("stamina") then
                gui.Visible = not isHudHidden
            end
        end
    end
end)

print("⚡ โหลดเมนู Hub สำเร็จ พร้อมใช้งานแล้ว!")
